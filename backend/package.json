{
  "name": "bioaudit-backend",
  "version": "1.0.0",
  "description": "REST API for BioAudit: accounts, organisations, scan history, AI explanations, and reporting.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/smoke.mjs",
    "test:integration": "firebase emulators:exec --project bioaudit-test --only auth,firestore \"node tests/integration.mjs\"",
    "dev:emulated": "firebase emulators:exec --project bioaudit-test --only auth,firestore \"node --env-file=.env.emulated src/server.js\"",
    "emulators": "firebase emulators:start --project bioaudit-test --only auth,firestore",
    "lint": "eslint src"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@google/genai": "^0.14.0",
    "@langchain/langgraph": "^1.4.12"
  },
  "devDependencies": {
    "eslint": "^9.9.0"
  }
}
