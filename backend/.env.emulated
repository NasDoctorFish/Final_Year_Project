# Settings for running the API against the local Firebase emulators.
#
# Used by `npm run dev:emulated`, which is how the Python client tests get a live server
# to talk to without a real Firebase project. Safe to commit: there are no real
# credentials here, because the emulators authenticate nobody.
#
# Load it with:  node --env-file=.env.emulated src/server.js
# (npm run dev:emulated does this for you.)

PORT=4000
NODE_ENV=development
GCLOUD_PROJECT=bioaudit-test
FIREBASE_PROJECT_ID=bioaudit-test
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_WEB_API_KEY=emulator-key
GEMINI_API_KEY=
FREE_HISTORY_LIMIT=10

# Relaxed for testing only. The integration and client test suites make far more
# sign-ins than a real person would, and the production defaults (120/min and
# 20 auth attempts per 15 minutes) would otherwise stop the suite partway through.
API_RATE_LIMIT_PER_MINUTE=100000
AUTH_RATE_LIMIT_PER_15MIN=100000
